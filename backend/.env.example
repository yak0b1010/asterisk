# ── Database ─────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to build the PostgreSQL URL from the DB_* values.
# For local development without PostgreSQL you can use:
#   DATABASE_URL=sqlite:///./data/app.db
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asterisk
DB_USER=asterisk
DB_PASSWORD=asterisk

# ── Authentication ───────────────────────────────────────────────────────
# Change this before deploying. Use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=480

# Initial accounts created only when the users table is empty.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_DEMO_DATA=true

# ── Asterisk AMI ─────────────────────────────────────────────────────────
# Leave AMI_HOST empty to run the dashboard without Asterisk (dev mode).
AMI_HOST=
AMI_PORT=5038
AMI_USERNAME=backend
AMI_PASSWORD=
AMI_TIMEOUT=2

# ── PBX configuration generation ─────────────────────────────────────────
# The backend writes pjsip_endpoints.conf, queues.conf and voicemail.conf here.
# In Docker this is mounted from ./asterisk/generated.
PBX_CONFIG_DIR=../asterisk/generated
PBX_FQDN=asterisk.local
# Public IP for phones behind NAT (optional).
PBX_PUBLIC_IP=
PBX_RELOAD_ENABLED=true

# ── HTTP ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
