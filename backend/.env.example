# ── Backend ──────────────────────────────────────────────────────────────
APP_ENV=development
# Bind address used by `python -m app` and the container entrypoint.
HTTP_ADDR=:8080
LOG_LEVEL=info
DATA_DIR=./data
AUTO_MIGRATE=true

# ── Database ─────────────────────────────────────────────────────────────
# Either set DATABASE_URL (wins) or the individual DB_* values.
# When the API runs on the host and PostgreSQL runs in Docker, DB_HOST is
# localhost and DB_PORT is the *published* host port (the project .env uses
# 5232).  Inside Compose the API uses DB_HOST=postgres and DB_PORT=5432.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5232
DB_NAME=astrisk
DB_USER=astrisk_user
DB_PASSWORD=12345678
DB_SSLMODE=disable

# Used by `docker compose` for the PostgreSQL image and published port.
POSTGRES_VERSION=18
BACKEND_PORT=8080

# ── Authentication ───────────────────────────────────────────────────────
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ISSUER=asterisk-backend
JWT_AUDIENCE=asterisk-dashboard
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Bootstrapped on first start only (a user is created if the table is empty).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=admin@asterisk.local

# ── HTTP ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# ── Asterisk control plane (optional; API degrades gracefully when absent) ─
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=backend
ASTERISK_AMI_PASSWORD=
ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USERNAME=asterisk
ASTERISK_ARI_PASSWORD=
# PJSIP transport name baked into asterisk/conf/base/pjsip.conf
ASTERISK_TRANSPORT=transport-udp
