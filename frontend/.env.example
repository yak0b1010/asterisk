# Base URL of the backend API (relative = same origin, proxied by Vite in dev / nginx in Docker)
VITE_API_URL=/api
# true = use the built-in mock API (no backend needed). The Docker image
# builds with false; set false here too when running `npm run dev` against
# the FastAPI backend.
VITE_USE_MOCK=false
# Dev only: where Vite proxies /api
VITE_PROXY_TARGET=http://localhost:8000
