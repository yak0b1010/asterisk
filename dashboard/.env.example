# Base URL of the backend API (relative = same origin, proxied by Vite in dev / nginx in Docker)
VITE_API_URL=/api
# true = use the built-in mock API (no backend needed). Set to false once the backend is ready.
VITE_USE_MOCK=true
# Dev only: where Vite proxies /api
VITE_PROXY_TARGET=http://localhost:8000
