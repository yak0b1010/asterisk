# ── Base image pin ───────────────────────────────────────────────────────
ASTERISK_IMAGE=andrius/asterisk
ASTERISK_TAG=22.8-cert4_debian-trixie-8d9e955
ASTERISK_DIGEST=sha256:f3bd01300f0c36c8a7ea5bd9472c4b906d0f85410c3ea429166a0fedac6ad3ee

# ── Appliance image ──────────────────────────────────────────────────────
ASTERISK_APP_IMAGE=asterisk-appliance
# The backend-generated configuration targets standalone mode.
ASTERISK_MODE=standalone

# ── Published ports on the Docker host ───────────────────────────────────
SIP_PORT=5060
# Must be a contiguous range "start-end"; it is written into rtp.conf at start
RTP_RANGE=10000-10199
HTTP_PORT=8088
WSS_PORT=8089
DASHBOARD_PORT=8080

# ── AMI (backend <-> Asterisk inside the Compose network) ────────────────
AMI_PORT=5038
# CHANGE THIS before exposing the appliance to a real network.
AMI_PASSWORD=change-me-ami-password
# ARI is optional and unused by the current backend.
ARI_PASSWORD=

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_VERSION=18
DB_HOST=postgres
DB_PORT=5432
DB_NAME=asterisk
DB_USER=asterisk
# CHANGE THIS before deploying.
DB_PASSWORD=change-me-db-password

# ── Backend authentication / initial accounts ────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_MINUTES=480
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
# Creates operator/operator, viewer/viewer and a small demo directory.
SEED_DEMO_DATA=true

# ── PBX identity ─────────────────────────────────────────────────────────
PBX_FQDN=asterisk.local
# Public IP of the server, for phones behind NAT (optional).
PBX_PUBLIC_IP=
FIREWALL_ENABLED=yes
FIREWALL_MODE=runtime
FIREWALL_POLICY=asterisk-appliance
