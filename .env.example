# ── Asterisk base image pin ───────────────────────────────────────────────
# Used by the Asterisk container (friend's part). Do not change unless
# you coordinate with the Asterisk developer.
ASTERISK_IMAGE=mlan/asterisk
ASTERISK_TAG=full-1.1.13
ASTERISK_DIGEST=sha256:c7b0b09903eec29f54601d32d7cd9aca859043144062db49e5054ae8f513745d

# ── Appliance image ──────────────────────────────────────────────────────
ASTERISK_APP_IMAGE=asterisk-appliance
# standalone | realtime
ASTERISK_MODE=standalone

# ── Runtime identity ─────────────────────────────────────────────────────
# PUID/PGID: numeric user and group IDs assigned to files generated at
# container start (TLS certificate and private key).
PUID=1000
PGID=1000

# ── Published ports ──────────────────────────────────────────────────────
SIP_PORT=5060
# Must be a contiguous range "start-end"; it is written into rtp.conf at start
RTP_RANGE=10000-10199
HTTP_PORT=8088
WSS_PORT=8089
DASHBOARD_PORT=8080

# ── AMI / ARI (rendered into the Asterisk container at start) ────────────
AMI_PASSWORD=
ARI_PASSWORD=

# ── PostgreSQL (shared) ──────────────────────────────────────────────────
# Used by both the backend API and Asterisk (via ODBC realtime).
POSTGRES_VERSION=16
DB_HOST=postgres
DB_PORT=5432
DB_NAME=asterisk
DB_USER=asterisk
DB_PASSWORD=asterisk_pass
PGDATA_PATH=/var/lib/postgresql/data

# Optional PBX demo, only on first initialization of an empty volume.
# Only exact "yes" enables it; all other values skip (default: no).
# Changing this never reseeds an existing database.
DEMO_DATA=no

# ── Backend (Flask API — our part) ───────────────────────────────────────
BACKEND_PORT=5000
FRONTEND_PORT=80
JWT_SECRET_KEY=change-me-in-production-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080

# ── Ports exposed on host ────────────────────────────────────────────────
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=8080

# ── Asterisk runtime (realtime mode only) ────────────────────────────────
# Required when ASTERISK_MODE=realtime. Rendered into odbc.ini and
# res_odbc.conf by scripts/entrypoint-wrapper.sh at container start.
PBX_FQDN=asterisk.local
FIREWALL_ENABLED=yes
FIREWALL_MODE=runtime
FIREWALL_POLICY=asterisk-appliance
